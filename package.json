{
    "name": "@cyanmycelium/mcp-history-workspace",
    "version": "0.1.0",
    "description": "History slots for an mcp-broker: the history.v1 contract, its MCP surface, and pluggable stores.",
    "type": "module",
    "license": "Apache-2.0",
    "private": true,
    "engines": {
        "node": ">=20.11.0"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "npm run build -w @cyanmycelium/mcp-history && npm run build -w @cyanmycelium/mcp-history-sqlite && npm run build -w @cyanmycelium/mcp-history-recorder",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "format": "prettier --check \"packages/*/src/**/*.ts\" \"tests/**/*.ts\"",
        "format:fix": "prettier --write \"packages/*/src/**/*.ts\" \"tests/**/*.ts\"",
        "test:live": "vitest run --config vitest.live.config.ts",
        "bench:append": "vitest run --config vitest.bench.config.ts"
    },
    "devDependencies": {
        "@cyanmycelium/mcp-broker": "^1.6.0",
        "@cyanmycelium/mcp-broker-provider": "^0.3.0",
        "@cyanmycelium/mcp-core": "^1.4.1",
        "@types/node": "^20.11.0",
        "prettier": "^3.2.0",
        "tsup": "^8.5.1",
        "typescript": "^5.4.0",
        "vitest": "^4.1.9"
    }
}
